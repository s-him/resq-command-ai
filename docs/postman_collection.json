              "mode": "raw",
              "raw": "{\n  \"description\": \"Water entering ground-floor homes near the river bank.\",\n  \"hazard_type\": \"flood\",\n  \"help_needed\": [\n    \"evacuation\",\n    \"food\"\n  ],\n  \"location\": \"Ward 12, Riverside Road\",\n  \"people_affected\": 40,\n  \"reported_at\": \"2026-11-19T10:30:00+05:30\",\n  \"vulnerable_groups\": [\n    \"children\",\n    \"elderly\"\n  ]\n}",
