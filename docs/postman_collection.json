              "raw": "{\n  \"hazard_type\": \"earthquake\",\n  \"description\": \"Several buildings damaged; trapped residents and many injuries reported.\",\n  \"location\": \"Old Town, Ward 1\",\n  \"reported_at\": \"2026-11-19T11:30:00+05:30\",\n  \"people_affected\": 300,\n  \"help_needed\": [\n    \"rescue\",\n    \"medical\",\n    \"shelter\"\n  ]\n}",
