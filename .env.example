# Optional OpenAI-compatible provider. Rules-only mode is the default.
LLM_ENABLED=false
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=8

# The optional AUTO simulation skips human review. Keep false for the project demo.
RESQ_ALLOW_AUTO_DISPATCH=false
